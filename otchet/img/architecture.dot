// Архитектура платформы Boostaurant — Рисунок для раздела 1.3
digraph arch {
    graph [rankdir=TB, splines=spline, nodesep=0.65, ranksep=0.42, bgcolor="white",
           fontname="Helvetica", compound=true];
    node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", penwidth=1.1];
    edge  [fontname="Helvetica", fontsize=8.5, color="#555555", penwidth=1.1];

    subgraph cluster_rest {
        label="Ресторан";
        fontsize=11; fontcolor="#666666"; color="#BBBBBB"; style=dashed;
        waiter [label="Официант\n(смартфон)", fillcolor="#FDF0D5", color="#D9A441"];
        iiko   [label="iiko\nCRM ресторана", fillcolor="#EDEDED", color="#999999"];
    }

    tg [label="Telegram", fillcolor="#EDEDED", color="#999999"];

    subgraph cluster_srv {
        label="Сервер платформы (VPS, изолированная сеть Docker)";
        fontsize=11; fontcolor="#666666"; color="#BBBBBB"; style=dashed;

        bot  [label="Telegram-бот\naiogram 3.x", fillcolor="#E8EEF7", color="#7A9CC6"];
        api  [label="Сервис рекомендаций\nFastAPI", fillcolor="#E8EEF7", color="#7A9CC6"];
        rec  [label="Рекомендательное ядро\nSVD → k-means → popularity", fillcolor="#F5D9A8", color="#D9A441"];
        sync [label="Синхронизатор\n(по расписанию)", fillcolor="#E8EEF7", color="#7A9CC6"];
        db   [label="PostgreSQL", shape=cylinder, style=filled, fillcolor="#DCEBDC", color="#7FA87F"];
        mdl  [label="Обученные модели\nsvd.pkl · kmeans.pkl", shape=note, fillcolor="#FBEFD8", color="#D9A441"];
        train [label="Обучение моделей\n(еженедельно)", fillcolor="#E8EEF7", color="#7A9CC6"];
    }

    waiter -> tg  [label="номер столика"];
    tg -> bot     [label="long polling"];
    bot -> api    [label="HTTP\nвнутри сети"];
    api -> rec;
    rec -> db     [label="история,\nпредпочтения"];
    rec -> mdl    [label="загрузка\nмоделей"];
    api -> db     [label="профиль,\nзаметки"];

    iiko -> sync  [label="выгрузка заказов\nи профилей"];
    sync -> db;
    db -> train   [label="обучающая\nвыборка"];
    train -> mdl  [label="сохранение"];

}
